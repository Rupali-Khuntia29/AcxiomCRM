@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
  <div><div class="eyebrow">OVERVIEW</div><h1 class="page-title">Sales Dashboard</h1><p class="text-secondary mb-0">Your customer relationships, opportunities, and activity at a glance.</p></div>
  <div class="text-secondary small">Updated @DateTime.Now.ToString("dd MMM yyyy")</div>
</div>
<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Total Customers</div><div class="metric-value">@ViewBag.Customers</div><div class="metric-foot">Customer records</div></div></div>
  <div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Total Leads</div><div class="metric-value">@ViewBag.Leads</div><div class="metric-foot">Prospective customers</div></div></div>
  <div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Opportunities</div><div class="metric-value">@ViewBag.Opportunities</div><div class="metric-foot"><span class="text-success">@ViewBag.Won won</span> · <span class="text-danger">@ViewBag.Lost lost</span></div></div></div>
  <div class="col-6 col-xl-3"><div class="metric-card metric-primary"><div class="metric-label">Open Pipeline</div><div class="metric-value">₹@(((decimal)ViewBag.Pipeline).ToString("N0"))</div><div class="metric-foot">Weighted sales visibility</div></div></div>
</div>
<div class="row g-3">
  <div class="col-xl-8">
    <div class="panel h-100">
      <div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="mb-1">Quick actions</h5><p class="text-secondary small mb-0">Create and manage core CRM records.</p></div><span class="badge rounded-pill text-bg-light">Workspace</span></div>
      <div class="row g-3">
        <div class="col-md-6"><a class="action-tile" asp-controller="Customers" asp-action="Create"><span class="action-icon">＋</span><span><strong>Add customer</strong><small>Create a new customer profile</small></span><span class="ms-auto">→</span></a></div>
        <div class="col-md-6"><a class="action-tile" asp-controller="Leads" asp-action="Create"><span class="action-icon">↗</span><span><strong>Add lead</strong><small>Capture a sales prospect</small></span><span class="ms-auto">→</span></a></div>
        <div class="col-md-6"><a class="action-tile" asp-controller="Opportunities" asp-action="Create"><span class="action-icon">₹</span><span><strong>New opportunity</strong><small>Track a potential deal</small></span><span class="ms-auto">→</span></a></div>
        <div class="col-md-6"><a class="action-tile" asp-controller="FollowUps" asp-action="Create"><span class="action-icon">◷</span><span><strong>Schedule follow-up</strong><small>Plan the next customer touchpoint</small></span><span class="ms-auto">→</span></a></div>
      </div>
    </div>
  </div>
  <div class="col-xl-4"><div class="panel h-100"><h5 class="mb-1">Follow-up queue</h5><p class="text-secondary small">Planned activities from today onward</p><div class="big-number">@ViewBag.FollowUps</div><div class="progress mt-3" role="progressbar"><div class="progress-bar" style="width:70%"></div></div><p class="text-secondary small mt-3 mb-0">Keep customer conversations moving with timely follow-ups.</p></div></div>
</div>
<div class="panel mt-3">
  <div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="mb-1">Recently added customers</h5><p class="text-secondary small mb-0">Latest customer records in the system.</p></div><a class="btn btn-sm btn-outline-primary" asp-controller="Customers" asp-action="Index">View all</a></div>
  <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Customer</th><th>Company</th><th>Email</th><th>Status</th><th>Created</th></tr></thead><tbody>
  @foreach (Customer c in ViewBag.RecentCustomers) { <tr><td class="fw-semibold">@c.CustomerName</td><td>@(c.CompanyName ?? "—")</td><td>@c.Email</td><td><span class="status-pill">@c.Status</span></td><td>@c.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td></tr> }
  @if (((IEnumerable<Customer>)ViewBag.RecentCustomers).Any() == false) { <tr><td colspan="5" class="text-center text-secondary py-4">No customers yet. Use “Add customer” to create your first record.</td></tr> }
  </tbody></table></div>
</div>
