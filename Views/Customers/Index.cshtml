@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><div class="eyebrow">RELATIONSHIPS</div><h1 class="page-title">Customers</h1><p class="text-secondary mb-0">Manage your customer directory.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add customer</a></div>
<form method="get" class="searchbar mb-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, email, phone or company..." /><button class="btn btn-outline-secondary">Search</button></form>
<div class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Customer</th><th>Company</th><th>Email</th><th>Phone</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach (var c in Model) { <tr><td class="fw-semibold">@c.CustomerName</td><td>@(c.CompanyName ?? "—")</td><td>@c.Email</td><td>@c.Phone</td><td><span class="status-pill">@c.Status</span></td><td><a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-primary">Edit</a> @if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a asp-action="Deactivate" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Deactivate this customer?')">Deactivate</a> }</td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-secondary py-4">No customers found.</td></tr> }
</tbody></table></div></div>
