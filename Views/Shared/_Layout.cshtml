<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark crm-nav">
  <div class="container-fluid px-4">
    <a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">Acxiom<span class="brand-accent">CRM</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        @if (User.Identity?.IsAuthenticated == true) {
          <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index">Follow-ups</a></li>
          @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Audit Log</a></li> }
        }
      </ul>
      <div class="d-flex align-items-center gap-3">
        @if (User.Identity?.IsAuthenticated == true) {
          <span class="text-white-50 small">@User.Identity.Name</span>
          <form method="post" action="/Account/Logout" class="m-0">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-light">Logout</button></form>
        } else {
          <a class="btn btn-sm btn-light" href="/Account/Login">Login</a>
          <a class="btn btn-sm btn-outline-light" href="/Account/Register">Register</a>
        }
      </div>
    </div>
  </div>
</nav>
<main class="container-fluid px-4 py-4">
  @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
  @RenderBody()
</main>
<footer class="container-fluid px-4 py-3 text-secondary small border-top">AcxiomCRM · Customer & Sales Management</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
