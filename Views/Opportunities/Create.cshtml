@model Opportunity
@{ ViewData["Title"] = "New opportunity"; }
<div class="mb-4"><a asp-action="Index">← Opportunities</a><h1 class="page-title mt-3">New opportunity</h1><p class="text-secondary">Opportunity amount must be greater than zero; probability must be 0–100.</p></div>
<div class="panel form-panel"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="OpportunityName" class="form-label">Opportunity name *</label><input asp-for="OpportunityName" class="form-control"/><span asp-validation-for="OpportunityName" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">Select customer</option>@foreach (Customer c in ViewBag.Customers) { <option value="@c.CustomerId">@c.CustomerName</option> }</select></div>
<div class="col-md-6"><label asp-for="Amount" class="form-label">Amount (₹) *</label><input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control"/><span asp-validation-for="Amount" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="Probability" class="form-label">Probability (%)</label><input asp-for="Probability" type="number" min="0" max="100" class="form-control"/><span asp-validation-for="Probability" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="Stage" class="form-label">Stage</label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div>
<div class="col-md-6"><label asp-for="ExpectedCloseDate" class="form-label">Expected close date</label><input asp-for="ExpectedCloseDate" type="date" class="form-control"/><span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span></div>
</div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save opportunity</button><a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
