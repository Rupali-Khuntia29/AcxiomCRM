@model IEnumerable<Opportunity>
@{ ViewData["Title"] = "Opportunities"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">REVENUE PIPELINE</div><h1 class="page-title">Opportunities</h1><p class="text-secondary mb-0">Track deal stages, values and close dates.</p></div><a class="btn btn-primary" asp-action="Create">＋ New opportunity</a></div>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Opportunity</th><th>Customer</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Weighted value</th><th>Expected close</th></tr></thead><tbody>
@foreach (var x in Model) { <tr><td class="fw-semibold">@x.OpportunityName</td><td>@(x.Customer?.CustomerName ?? "—")</td><td><span class="status-pill">@x.Stage</span></td><td>₹@x.Amount.ToString("N0")</td><td>@x.Probability%</td><td>₹@x.WeightedValue.ToString("N0")</td><td>@x.ExpectedCloseDate.ToString("dd MMM yyyy")</td></tr> }
@if (!Model.Any()) { <tr><td colspan="7" class="text-center text-secondary py-4">No opportunities found.</td></tr> }
</tbody></table></div>
