@model FollowUp
@{ ViewData["Title"] = "Schedule follow-up"; }
<div class="mb-4"><a asp-action="Index">← Follow-ups</a><h1 class="page-title mt-3">Schedule follow-up</h1><p class="text-secondary">Choose a future date and define the next action.</p></div>
<div class="panel form-panel"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
<div class="col-md-6"><label asp-for="Subject" class="form-label">Subject *</label><input asp-for="Subject" class="form-control"/><span asp-validation-for="Subject" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="FollowUpType" class="form-label">Type</label><select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div>
<div class="col-md-6"><label asp-for="FollowUpDate" class="form-label">Date and time</label><input asp-for="FollowUpDate" type="datetime-local" class="form-control"/><span asp-validation-for="FollowUpDate" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option>Planned</option><option>Completed</option><option>Missed</option><option>Cancelled</option></select></div>
<div class="col-12"><label asp-for="Remarks" class="form-label">Remarks</label><textarea asp-for="Remarks" class="form-control" rows="3"></textarea></div>
</div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save follow-up</button><a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
