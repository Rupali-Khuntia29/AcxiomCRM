@model Lead
@{ ViewData["Title"] = "Add lead"; }
<div class="mb-4"><a asp-action="Index">← Leads</a><h1 class="page-title mt-3">Add lead</h1><p class="text-secondary">Capture a new sales prospect.</p></div>
<div class="panel form-panel"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="LeadName" class="form-label">Lead name *</label><input asp-for="LeadName" class="form-control"/><span asp-validation-for="LeadName" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="CompanyName" class="form-label">Company</label><input asp-for="CompanyName" class="form-control"/></div>
<div class="col-md-6"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="Phone" class="form-label">Phone</label><input asp-for="Phone" class="form-control"/><span asp-validation-for="Phone" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="Source" class="form-label">Source</label><select asp-for="Source" class="form-select"><option>Website</option><option>Referral</option><option>Campaign</option><option>Cold Call</option><option>Other</option></select></div>
<div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option>New</option><option>Contacted</option><option>Qualified</option><option>Unqualified</option><option>Converted</option><option>Lost</option></select></div>
<div class="col-md-6"><label asp-for="ExpectedValue" class="form-label">Expected value (₹)</label><input asp-for="ExpectedValue" class="form-control" type="number" min="0" step="0.01"/><span asp-validation-for="ExpectedValue" class="text-danger small"></span></div>
</div><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save lead</button><a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
